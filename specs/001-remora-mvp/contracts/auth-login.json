{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthLoginContract",
  "description": "Contract for /v1/auth/login-demo endpoint",
  "type": "object",
  "required": ["username", "password"],
  "properties": {
    "username": {
      "type": "string",
      "example": "demo_student_01"
    },
    "password": {
      "type": "string",
      "example": "password123"
    }
  },
  "additionalProperties": false
}
