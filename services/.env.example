# Remora Backend Environment Configuration
# Copy this file to .env before running docker compose

# AI & Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Gateway Secrets (Required, No defaults)
JWT_SECRET=generate_a_secure_random_jwt_secret_key_here
DEMO_USERNAME=demo_student_01
DEMO_PASSWORD=your_secure_demo_password_here
INTERNAL_SERVICE_KEY=generate_a_secure_mesh_internal_key_here

# PostgreSQL Database
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
